# ============================================================
# AfroShop Cloud Lab — Variables d'environnement
# ============================================================
# INSTRUCTIONS : Copiez ce fichier en `.env`, puis renseignez
# vos vraies valeurs. Le fichier `.env` est ignoré par Git.
# NE JAMAIS COMMITTER LE FICHIER .env !
# ============================================================

# Clé API Gemini (Google AI Studio ou Vertex AI)
GEMINI_API_KEY=your-gemini-api-key-here

# Projet GCP
GCP_PROJECT_ID=your-gcp-project-id

# Région GCP (ex: europe-west1)
GCP_REGION=europe-west1

# (Optionnel) Nom du log Cloud Logging
GCP_LOG_NAME=afroshop-security-events
